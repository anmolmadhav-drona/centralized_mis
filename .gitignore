# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real environment files are NEVER committed; the template IS
.env*
!.env.example

# generated fixtures (rebuild with: bun scripts/make-import-fixtures.ts)
/tests/fixtures/

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
# local-* scratch files — but NOT the local development guide
!docs/local-development.md
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# local databases (PostgreSQL workspace — data lives outside the repo)
/db/

# workspace artifacts — kept on disk for the sandbox, never cloned
/download/
/screenshots/
/tool-results/

# workspace plumbing (platform sandbox runtime) — kept on disk, never cloned
/.zscripts/
/tests/*.sh
/examples/
/scripts/xlsx_extract/
worklog.md
/Caddyfile

# upload scratch space — only the seed workbook is tracked
/upload/*
!/upload/Updated\ MIS\ NPL\ SONIPAT.xlsx
docker-compose.prod.local.yml