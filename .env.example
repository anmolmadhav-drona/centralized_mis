# ============================================================================
# NPL MIS Portal (Drona Logitech Centralized MIS) — environment reference.
#
# Copy:  cp .env.example .env        (local development)
#        — or just run `bun run setup:local`, which creates .env with
#          locally generated secrets automatically (never overwrites).
# Coolify: paste per-variable into each Application → Environment Variables.
#
# Rules:
#   • Every variable below is ACTUALLY CONSUMED by the code (grep-verified).
#   • Variables marked [secret] must never be committed, logged, or exposed
#     through NEXT_PUBLIC_*.
#   • The app validates its environment at startup (src/lib/env.ts) — in
#     production it refuses to start without the required variables and
#     fails loudly (but never prints secret values).
#   • S3 / AWS variables are intentionally ABSENT: the application itself
#     does not use object storage. Database backups run in Coolify and are
#     configured there (see docs/aws-s3-backup.md) — no AWS credentials are
#     needed in this app's environment.
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------

# NODE_ENV — production | development (set by the platform/entrypoint, not by hand)

# APP_URL — public origin of the web app, used ONLY to build password-reset
# email links when the proxy forwards an ambiguous origin. Optional: the
# request's own origin is used when unset.
#   purpose : reset-link base URL      secret: no      server-only
#   required: no                       format: https://mis.example.com
# APP_URL=https://mis.example.com

# MIGRATE_ON_START — the container entrypoint runs `prisma migrate deploy`
# before starting unless this is "false".
#   single replica : keep true (default)
#   multi replica  : set false on ALL replicas, run migrations once as an
#                    explicit deployment step (see docs/coolify-deployment.md)
#   purpose : startup migration gate   secret: no      server-only
#   required: no (default true)        format: true|false
# MIGRATE_ON_START=true

# QUERY_LOG — set to 1 to enable Prisma query logging (extremely verbose;
# leaks row data into logs — debugging only, never production).
#   purpose : db debug logging         secret: no      server-only
#   required: no (default off)         format: 1
# QUERY_LOG=1

# ----------------------------------------------------------------------------
# AUTHENTICATION (web app)
# ----------------------------------------------------------------------------

# AUTH_SECRET — signs the Auth.js (NextAuth v5) JWT session cookies.
#   purpose : session token signing    secret: YES    server-only
#   required: YES (≥32 chars — production refuses to start without it)
#   format  : random base64 — generate:  openssl rand -base64 32
#   Coolify : Web application → Environment Variables
AUTH_SECRET=

# ----------------------------------------------------------------------------
# DATABASE (web app)
# ----------------------------------------------------------------------------

# DATABASE_URL — PostgreSQL connection string. The app never bundles a
# database; use the Coolify PostgreSQL resource's internal connection string
# in production, or the local docker-compose.dev.yml stack in development.
#   purpose : database connection      secret: YES (contains credentials)
#   required: YES (production refuses to start without it)
#   format  : postgresql://user:password@host:5432/dbname
#   local   : postgresql://npl:npl_dev_password@127.0.0.1:5432/npl_mis
#   Coolify : Web application → Environment Variables (Postgres resource →
#             "Internal" URL, e.g. postgresql://...@postgres:5432/npl_mis)
DATABASE_URL=

# ----------------------------------------------------------------------------
# REALTIME — web application side
# ----------------------------------------------------------------------------

# REALTIME_URL — INTERNAL admin /emit endpoint of the realtime service,
# reachable over the private network (not through the public proxy).
#   purpose : where the app POSTs realtime events
#   secret  : no (private-network only)         server-only
#   required: YES in production (default http://127.0.0.1:3004 for local dev)
#   format  : http://<realtime-service-hostname>:3004
#   Coolify : Web application → Environment Variables
# REALTIME_URL=http://realtime-svc:3004

# REALTIME_SECRET — shared secret for the internal /emit endpoint; must match
# the realtime service's REALTIME_SECRET exactly.
#   purpose : authenticates web app → realtime service
#   secret  : YES                               server-only
#   required: YES in production (events are silently dropped without it)
#   format  : openssl rand -hex 24
#   Coolify : Web application AND realtime service (identical value)
REALTIME_SECRET=

# REALTIME_PUBLIC_URL — public URL the BROWSER connects to for Socket.IO
# (the realtime service's Coolify domain). Served to clients via /api/config.
#   purpose : client-side realtime endpoint      NOT secret (public by design)
#   required: YES in production (falls back to same-origin locally)
#   format  : https://rt.mis.example.com
#   Coolify : Web application → Environment Variables
# REALTIME_PUBLIC_URL=https://rt.mis.example.com

# ----------------------------------------------------------------------------
# REALTIME — realtime service side (mini-services/realtime)
# ----------------------------------------------------------------------------

# REALTIME_PORT — public Socket.IO port (the Coolify service port).
#   required: no (default 3003)    format: 3003
# REALTIME_PORT=3003

# REALTIME_ADMIN_PORT — internal admin port (POST /emit, GET /health).
# NEVER publish this port publicly.
#   required: no (default 3004)    format: 3004
# REALTIME_ADMIN_PORT=3004

# REALTIME_ADMIN_BIND — bind address for the admin endpoint. Inside Coolify
# the web app reaches the service over the docker network → 0.0.0.0. Keep
# 127.0.0.1 only when both services share a host (local non-Docker dev).
#   required: no (default 127.0.0.1)   format: 0.0.0.0 | 127.0.0.1
# REALTIME_ADMIN_BIND=0.0.0.0

# REALTIME_ALLOWED_ORIGIN — CORS allowlist for Socket.IO: the web app's public
# origin(s), comma-separated. Wildcards are refused in production.
#   required: YES in production     format: https://mis.example.com
#   Coolify : Realtime application → Environment Variables
# REALTIME_ALLOWED_ORIGIN=https://mis.example.com

# ----------------------------------------------------------------------------
# EMAIL (SMTP) — password-reset delivery (optional until the feature is used)
# ----------------------------------------------------------------------------

# Configure ALL of these together. With SMTP unset: local development prints
# reset emails to the server console (DEV MAIL SINK); production accepts
# reset requests but logs a loud error and sends NOTHING (never fakes
# delivery). See src/lib/services/mail.ts.

# SMTP_HOST — mail server hostname.
#   purpose : outbound email          secret: no      server-only
#   required: only when email is used
#   format  : smtp.example.com
# SMTP_HOST=

# SMTP_PORT — mail server port (587 STARTTLS or 465 implicit TLS).
#   required: no (default 587)       format: 587 | 465
# SMTP_PORT=587

# SMTP_USER / SMTP_PASSWORD — SMTP credentials (set together or not at all).
#   secret : SMTP_PASSWORD YES        server-only
#   format : SMTP_USER=mailer@example.com
# SMTP_USER=
# SMTP_PASSWORD=

# SMTP_FROM — From: address for outbound mail.
#   required: no (defaults to SMTP_USER)   format: no-reply@example.com
# SMTP_FROM=

# ----------------------------------------------------------------------------
# FIRST-ADMIN BOOTSTRAP (scripts/create-admin.mjs — run once, not a runtime var)
# ----------------------------------------------------------------------------

# ADMIN_EMAIL — email of the first administrator (validated).
# ADMIN_INITIAL_PASSWORD — initial password (≥8 chars; generate with
#   openssl rand -base64 24 — store it securely, it is not recoverable).
# ADMIN_NAME — display name (default "Administrator").
# ADMIN_ROLE — ADMIN (default) or MANAGER.
#   usage: ADMIN_EMAIL="ops@example.com" ADMIN_INITIAL_PASSWORD="…" \
#          DATABASE_URL="postgresql://…" node scripts/create-admin.mjs
# ADMIN_EMAIL=
# ADMIN_INITIAL_PASSWORD=
# ADMIN_NAME=
# ADMIN_ROLE=

# ----------------------------------------------------------------------------
# SEEDING (scripts/seed.ts — DEVELOPMENT ONLY)
# ----------------------------------------------------------------------------

# SEED_XLSX — override the sample workbook path (default: the tracked
# upload/Updated MIS NPL SONIPAT.xlsx). No secret. Optional.
# SEED_XLSX=

# ALLOW_PROD_SEED — set to "yes-i-know" to force seeding in production.
# DO NOT. The seed creates demo users with known passwords.
# ALLOW_PROD_SEED=

# ----------------------------------------------------------------------------
# NOT FOR PRODUCTION — sandbox/evaluation only
# ----------------------------------------------------------------------------

# NEXT_PUBLIC_DEMO_LOGIN=1 shows demo quick-login buttons on the sign-in page.
# Intended ONLY for the evaluation sandbox build — must NEVER be set for a
# production image (inlined into the client bundle at build time).
# NEXT_PUBLIC_DEMO_LOGIN=1
